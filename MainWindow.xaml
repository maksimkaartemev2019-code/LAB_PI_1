<Window x:Class="LAB_PI_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер привычек" Height="760" Width="1180"
        MinHeight="650" MinWidth="1000"
        Loaded="Window_Loaded">
    <DockPanel x:Name="RootPanel" Background="#F4F6FA">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить" Click="SaveMenuItem_Click"/>
                <MenuItem Header="Загрузить" Click="LoadMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Копировать" Click="CopyMenuItem_Click"/>
                <MenuItem Header="Вставить" Click="PasteMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Светлая тема" Click="LightThemeMenuItem_Click"/>
                <MenuItem Header="Темная тема" Click="DarkThemeMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Сохранить" Style="{StaticResource SecondaryButtonStyle}" Click="SaveMenuItem_Click"/>
            <Button Content="Сброс" Style="{StaticResource SecondaryButtonStyle}" Click="ResetButton_Click"/>
            <Separator/>
            <Button Content="Аватар" Style="{StaticResource SecondaryButtonStyle}" Click="LoadAvatarButton_Click"/>
            <ToggleButton x:Name="EditModeToggleButton"
                          Content="Режим редактирования"
                          Margin="4"
                          Padding="12,6"
                          IsChecked="True"
                          Checked="EditModeToggleButton_Changed"
                          Unchecked="EditModeToggleButton_Changed"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Готово"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ProfileSummaryTextBlock" Text="Профиль не сохранен"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="6" Padding="8" BorderBrush="#CCD4E0" BorderThickness="1" Background="White">
                <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem Header="Личные данные">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="Основная информация">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Content="Имя"/>
                                        <TextBox x:Name="FirstNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="Фамилия"/>
                                        <TextBox x:Name="LastNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                                        <Label Grid.Row="2" Grid.Column="0" Content="Пароль"/>
                                        <PasswordBox x:Name="PasswordInputBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                                        <Label Grid.Row="3" Grid.Column="0" Content="Дата рождения"/>
                                        <DatePicker x:Name="BirthDatePicker" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Дополнительные данные">
                                    <StackPanel>
                                        <TextBlock Text="Образование"/>
                                        <ComboBox x:Name="EducationComboBox" Margin="0,4,0,10">
                                            <ComboBoxItem Content="Среднее"/>
                                            <ComboBoxItem Content="Среднее специальное"/>
                                            <ComboBoxItem Content="Высшее"/>
                                            <ComboBoxItem Content="Аспирантура"/>
                                        </ComboBox>
                                        <TextBlock Text="Хобби"/>
                                        <ListBox x:Name="HobbiesListBox" SelectionMode="Multiple" Height="115">
                                            <ListBoxItem Content="Спорт"/>
                                            <ListBoxItem Content="Чтение"/>
                                            <ListBoxItem Content="Музыка"/>
                                            <ListBoxItem Content="Программирование"/>
                                            <ListBoxItem Content="Путешествия"/>
                                        </ListBox>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox x:Name="DisplaySettingsGroupBox" Header="Настройки отображения">
                                    <StackPanel>
                                        <CheckBox x:Name="NotificationsCheckBox" Content="Получать уведомления" Margin="0,3"/>
                                        <CheckBox x:Name="PublicStatsCheckBox" Content="Показывать статистику публично" Margin="0,3"/>
                                        <CheckBox x:Name="AutoSaveCheckBox" Content="Автосохранение" Margin="0,3"/>
                                        <CheckBox x:Name="WeeklyReportCheckBox" Content="Еженедельный отчет" Margin="0,3"/>
                                        <TextBlock Text="Уровень активности" Margin="0,10,0,3"/>
                                        <WrapPanel>
                                            <RadioButton x:Name="LowActivityRadioButton" Content="Низкий" GroupName="Activity" Margin="0,0,14,0"/>
                                            <RadioButton x:Name="MediumActivityRadioButton" Content="Средний" GroupName="Activity" Margin="0,0,14,0" IsChecked="True"/>
                                            <RadioButton x:Name="HighActivityRadioButton" Content="Высокий" GroupName="Activity"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>

                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click"/>
                                    <Button Content="Сброс" Style="{StaticResource SecondaryButtonStyle}" Click="ResetButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Привычки">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="Новая привычка">
                                    <DockPanel>
                                        <TextBox x:Name="NewHabitTextBox" DockPanel.Dock="Left" MinWidth="180" Margin="0,0,8,0"/>
                                        <Button Content="Добавить" Style="{StaticResource PrimaryButtonStyle}" Click="AddHabitButton_Click"/>
                                    </DockPanel>
                                </GroupBox>
                                <GroupBox Header="Ежедневная оценка">
                                    <StackPanel>
                                        <TextBlock Text="Продуктивность"/>
                                        <Slider x:Name="ProductivitySlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="HabitSlider_ValueChanged"/>
                                        <TextBlock Text="Удовлетворенность"/>
                                        <Slider x:Name="SatisfactionSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="HabitSlider_ValueChanged"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <RepeatButton Content="-5" Width="50" Margin="0,0,8,0" Click="DecreaseProgressButton_Click"/>
                                            <RepeatButton Content="+5" Width="50" Click="IncreaseProgressButton_Click"/>
                                            <ProgressBar x:Name="DayProgressBar" Width="220" Height="22" Margin="12,0,0,0" Minimum="0" Maximum="100"/>
                                            <TextBlock x:Name="ProgressValueTextBlock" Margin="10,0,0,0" VerticalAlignment="Center" Text="0%"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Заметки и календарь">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RichTextBox x:Name="HabitNotesRichTextBox" Grid.Column="0" Height="170" Margin="0,0,8,0"/>
                                        <Calendar x:Name="HabitCalendar" Grid.Column="1" SelectedDatesChanged="HabitCalendar_SelectedDatesChanged"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Таблица привычек">
                                    <DataGrid x:Name="HabitsDataGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MinHeight="180"
                                              CellEditEnding="HabitsDataGrid_CellEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Привычка" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="100"/>
                                            <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsCompleted}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Статистика">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="Категории привычек">
                                    <TreeView x:Name="HabitCategoriesTreeView" Height="185">
                                        <TreeViewItem Header="Здоровье" IsExpanded="True">
                                            <TreeViewItem Header="Сон"/>
                                            <TreeViewItem Header="Вода"/>
                                            <TreeViewItem Header="Тренировки"/>
                                        </TreeViewItem>
                                        <TreeViewItem Header="Развитие" IsExpanded="True">
                                            <TreeViewItem Header="Чтение"/>
                                            <TreeViewItem Header="Учеба"/>
                                            <TreeViewItem Header="Практика"/>
                                        </TreeViewItem>
                                        <TreeViewItem Header="Быт">
                                            <TreeViewItem Header="Порядок"/>
                                            <TreeViewItem Header="Планирование"/>
                                        </TreeViewItem>
                                    </TreeView>
                                </GroupBox>
                                <GroupBox Header="Статистика по дням">
                                    <ListView x:Name="StatisticsListView" Height="240">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="День" DisplayMemberBinding="{Binding Day}" Width="115"/>
                                                <GridViewColumn Header="Выполнено" DisplayMemberBinding="{Binding Completed}" Width="85"/>
                                                <GridViewColumn Header="Всего" DisplayMemberBinding="{Binding Total}" Width="55"/>
                                                <GridViewColumn Header="Прогресс" DisplayMemberBinding="{Binding Progress}" Width="80"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Margin="6" Padding="10" BorderBrush="#CCD4E0" BorderThickness="1" Background="White">
                <StackPanel>
                    <TextBlock Text="Анализ привычек" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Центральная панель показывает текущий день, прогресс и таблицу привычек." TextWrapping="Wrap"/>
                    <Separator Margin="0,10"/>
                    <DataGrid ItemsSource="{Binding ElementName=HabitsDataGrid, Path=ItemsSource}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Height="260"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Привычка" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsCompleted}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border BorderBrush="#D6DEE9" BorderThickness="1" Padding="10" Background="#FBFCFE">
                        <StackPanel>
                            <TextBlock Text="Заметки о привычках" FontWeight="SemiBold"/>
                            <RichTextBox Height="165">
                                <FlowDocument>
                                    <Paragraph>Сегодня стоит отметить, какие привычки получилось выполнить и что помогло сохранить ритм.</Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="6" Padding="10" BorderBrush="#CCD4E0" BorderThickness="1" Background="White">
                <StackPanel>
                    <TextBlock Text="Управление" FontSize="20" FontWeight="Bold"/>
                    <Border Width="170" Height="170" Margin="0,12" BorderBrush="#B8C1CF" BorderThickness="1" Background="#EEF2F7">
                        <Grid>
                            <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
                            <TextBlock x:Name="AvatarPlaceholderTextBlock"
                                       Text="Аватар"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"/>
                        </Grid>
                    </Border>
                    <Button Content="Загрузить аватар" Style="{StaticResource SecondaryButtonStyle}" Click="LoadAvatarButton_Click"/>
                    <TextBlock Text="Быстрая статистика" FontWeight="SemiBold" Margin="0,18,0,6"/>
                    <ListView ItemsSource="{Binding ElementName=StatisticsListView, Path=ItemsSource}" Height="210">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="День" DisplayMemberBinding="{Binding Day}" Width="90"/>
                                <GridViewColumn Header="%" DisplayMemberBinding="{Binding Progress}" Width="55"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
